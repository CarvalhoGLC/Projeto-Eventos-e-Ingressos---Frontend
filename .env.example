# Local (desenvolvimento): aponte para o backend rodando na sua máquina
VITE_API_BASE_URL=http://127.0.0.1:8000

# Produção (Vercel): NÃO defina aqui — este arquivo não é usado no build
# do Vercel. Configure VITE_API_BASE_URL em Project Settings > Environment
